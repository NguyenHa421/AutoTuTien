{
  "manifest_version": 3,
  "name": "AutoGame - Tu Tiên",
  "version": "1.8.3",
  "description": "Tự chăm cây, múc nước, đánh boss và đi bí cảnh trong Discord - không dùng chuột.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
